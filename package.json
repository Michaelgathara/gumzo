{
  "name": "gumzo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Single-window AI inbox built on top of session-oriented runtimes.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.8.13",
    "typescript": "5.8.2"
  }
}
